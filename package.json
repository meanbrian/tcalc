{
  "name": "tcalc",
  "version": "1.0.0",
  "description": "Timecode and clip time calculator for editors",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
